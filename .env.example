# ---------------------------------------------------------------------------
# Venkat Sai Global — environment configuration
# Copy to .env.local for development. NEVER commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_URL=http://localhost:3000
# Default timezone used when a user has not chosen one (IANA name).
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database (PostgreSQL 15+) ----------------------------------------------
# Local dev uses the bundled server: `npm run db:start` (see scripts/db-local.mjs)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/venkatsai
DATABASE_POOL_MAX=10
DATABASE_SSL=false
LOCAL_PG_PORT=5433
LOCAL_PG_PASSWORD=postgres
LOCAL_PG_DATABASE=venkatsai

# --- Security (REQUIRED in production) ---------------------------------------
# HMAC key for session/verification token hashing.
SESSION_SECRET=
# 32-byte base64 key for AES-256-GCM field encryption (passport numbers, TOTP secrets...).
DATA_ENCRYPTION_KEY=
# Salt used to pseudonymise IP addresses in logs and analytics.
IP_HASH_SALT=
# Shared secret for /api/v1/cron/* endpoints (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Google sign-in (optional) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------------
# dev = store messages in the dev outbox (visible at /admin/system/dev-outbox); smtp = send.
EMAIL_TRANSPORT=dev
EMAIL_FROM="Venkat Sai Global <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- SMS / WhatsApp ------------------------------------------------------------
# dev = store in dev outbox. msg91 | twilio for SMS; meta for WhatsApp Cloud API.
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PROVIDER=dev
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- File storage ----------------------------------------------------------------
# local = files on disk (STORAGE_LOCAL_DIR, outside /public) — development / single-server hosts only
# blob  = Vercel Blob PRIVATE store (Vercel deployments; needs BLOB_READ_WRITE_TOKEN)
# s3    = any S3-compatible store (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Hostname that serves public objects (CDN), used for next/image remotePatterns.
STORAGE_PUBLIC_HOST=
# ClamAV daemon for malware scanning of uploads (optional; uploads are marked "not scanned" without it).
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Payments (optional; offline/manual payments always work) ---------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- First-time setup ---------------------------------------------------------------
# Used by `npm run db:seed` to create the first Super Admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
